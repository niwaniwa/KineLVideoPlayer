/* ==========================================================================
   Module Manager — overall layout
   ========================================================================== */
.kinel-modulemgr-root {
    flex-grow: 1;
    flex-direction: column;
}

.kinel-modulemgr-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: var(--unity-colors-app_toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    flex-shrink: 0;
}

.kinel-modulemgr-toolbar > .unity-object-field {
    flex-grow: 1;
    margin-right: 6px;
}

.kinel-modulemgr-body {
    flex-grow: 1;
    min-height: 0;
}

/* ==========================================================================
   Sidebar (left): category sections + module cards
   ========================================================================== */
.kinel-modulemgr-sidebar {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--unity-colors-window-background);
}

.kinel-modulemgr-sidebar-scroll {
    flex-grow: 1;
}

.kinel-modulemgr-categories-host {
    padding: 4px 4px 8px 4px;
}

.kinel-modulemgr-category-section {
    margin-bottom: 8px;
}

.kinel-modulemgr-category-header {
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--unity-colors-helpbox-text);
    padding: 6px 8px 2px 8px;
    -unity-text-align: middle-left;
}

.kinel-modulemgr-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    margin: 1px 4px;
    border-radius: 3px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-left-color;
    transition-duration: 0.12s;
}

.kinel-modulemgr-row:hover {
    background-color: rgba(59, 130, 246, 0.10);
}

.kinel-modulemgr-row--selected {
    background-color: rgba(59, 130, 246, 0.18);
    border-left-color: rgba(59, 130, 246, 1);
}

.kinel-modulemgr-row-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    -unity-font-style: normal;
}

.kinel-modulemgr-row-sub {
    opacity: 0.55;
    -unity-font-style: italic;
    -unity-text-align: middle-right;
    margin-left: 8px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.kinel-modulemgr-hint {
    padding: 12px;
    opacity: 0.65;
    white-space: normal;
}

/* ==========================================================================
   Main (right): header + inspector
   ========================================================================== */
.kinel-modulemgr-main {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--unity-colors-window-background);
}

.kinel-modulemgr-main-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.kinel-modulemgr-main-title {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.kinel-modulemgr-spacer {
    flex-grow: 1;
}

.kinel-modulemgr-secondary-button {
    margin-left: 4px;
}

.kinel-modulemgr-inspector-scroll {
    flex-grow: 1;
}

.kinel-modulemgr-inspector-host {
    padding: 8px 12px;
}
